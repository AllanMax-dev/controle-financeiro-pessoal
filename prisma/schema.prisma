generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL
  INVESTMENT
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  SETTLED
  CANCELED
}

enum DebtInstallmentFrequency {
  MONTHLY
  FORTNIGHTLY
}

enum DebtInstallmentStatus {
  PENDING
  PAID
  CANCELED
}

enum SalaryFrequency {
  MONTHLY
  FORTNIGHTLY
}

enum CreditCardInvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
  CANCELED
}

enum CreditCardPurchaseInstallmentStatus {
  OPEN
  CANCELED
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SavingsGoalMovementType {
  DEPOSIT
  WITHDRAWAL
}

model Workspace {
  id             String      @id @default(uuid()) @db.Uuid
  slug           String      @unique @db.VarChar(80)
  name           String      @db.VarChar(120)
  currency       String      @default("BRL") @db.Char(3)
  timezone       String      @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  editors        Editor[]
  accounts       FinancialAccount[]
  categories     Category[]
  transactions   Transaction[]
  transfers      Transfer[]
  fixedExpenses  FixedExpense[]
  salaries       Salary[]
  debts          Debt[]
  installments   DebtInstallment[]
  creditCards    CreditCard[]
  cardPurchases  CreditCardPurchase[]
  cardInstallments CreditCardInstallment[]
  cardInvoices   CreditCardInvoice[]
  cardPayments   CreditCardInvoicePayment[]
  savingsGoals   SavingsGoal[]
  goalMovements  SavingsGoalMovement[]
  investments    Investment[]
  adjustments    BalanceAdjustment[]
  auditLogs      AuditLog[]
}

model Editor {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  displayName    String      @db.VarChar(80)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants         AccessGrant[]
  accounts       FinancialAccount[]
  transactions   Transaction[]
  transfersFrom  Transfer[]  @relation("TransferSourcePerson")
  transfersTo    Transfer[]  @relation("TransferDestinationPerson")
  fixedExpenses  FixedExpense[]
  salaries       Salary[]
  debts          Debt[]
  installments   DebtInstallment[]
  creditCards    CreditCard[]
  cardPurchases  CreditCardPurchase[]
  cardInstallments CreditCardInstallment[]
  cardInvoices   CreditCardInvoice[]
  cardPayments   CreditCardInvoicePayment[]
  savingsGoals   SavingsGoal[]
  goalMovements  SavingsGoalMovement[]
  investments    Investment[]
  adjustments    BalanceAdjustment[]
  auditLogs      AuditLog[]

  @@unique([workspaceId, displayName])
  @@index([workspaceId, active])
}

model AccessGrant {
  id         String          @id @default(uuid()) @db.Uuid
  editorId   String          @db.Uuid
  tokenHash  String          @unique @db.Char(64)
  active     Boolean         @default(true)
  lastUsedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  editor     Editor          @relation(fields: [editorId], references: [id], onDelete: Cascade)
  sessions   AccessSession[]

  @@index([editorId, active])
}

model AccessSession {
  id        String      @id @default(uuid()) @db.Uuid
  grantId   String      @db.Uuid
  tokenHash String      @unique @db.Char(64)
  expiresAt DateTime    @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  grant     AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

model FinancialAccount {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  name           String      @db.VarChar(100)
  institution    String?     @db.VarChar(100)
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(19, 2)
  color          String?     @db.VarChar(7)
  active         Boolean     @default(true)
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  transactions   Transaction[]
  sourceTransfers Transfer[] @relation("TransferSource")
  destinationTransfers Transfer[] @relation("TransferDestination")
  adjustments    BalanceAdjustment[]
  fixedExpenses  FixedExpense[]
  salaries       Salary[]
  creditCardPayments CreditCard[] @relation("CreditCardPaymentAccount")
  invoicePayments CreditCardInvoicePayment[]
  savingsGoals   SavingsGoal[]
  goalMovements  SavingsGoalMovement[]
  investments    Investment[]

  @@unique([workspaceId, personEditorId, name])
  @@index([workspaceId, active])
  @@index([workspaceId, personEditorId])
  @@index([workspaceId, type])
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String       @db.VarChar(100)
  kind        CategoryKind
  color       String?      @db.VarChar(7)
  active      Boolean      @default(true)
  createdByEditorId String? @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  fixedExpenses FixedExpense[]
  salaries    Salary[]
  debts       Debt[]
  cardPurchases CreditCardPurchase[]
  cardInstallments CreditCardInstallment[]

  @@unique([workspaceId, kind, name])
  @@index([workspaceId, kind, active])
}

model Transaction {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  categoryId     String?     @db.Uuid
  fixedExpenseId String?     @db.Uuid
  salaryId       String?     @db.Uuid
  debtInstallmentId String?  @unique @db.Uuid
  creditCardInstallmentId String? @unique @db.Uuid
  description    String      @db.VarChar(160)
  type           TransactionType
  amount         Decimal     @db.Decimal(19, 2)
  competenceDate DateTime    @db.Date
  dueDate        DateTime?   @db.Date
  settledAt      DateTime?   @db.Date
  status         TransactionStatus @default(PENDING)
  affectsBalance Boolean     @default(true)
  notes          String?     @db.Text
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  salary         Salary?     @relation(fields: [salaryId], references: [id], onDelete: SetNull)
  debtInstallment DebtInstallment? @relation(fields: [debtInstallmentId], references: [id], onDelete: SetNull)
  creditCardInstallment CreditCardInstallment? @relation(fields: [creditCardInstallmentId], references: [id], onDelete: SetNull)

  @@unique([fixedExpenseId, competenceDate])
  @@unique([salaryId, competenceDate])
  @@index([workspaceId, personEditorId, competenceDate])
  @@index([workspaceId, type, status])
  @@index([workspaceId, accountId])
}

model BalanceAdjustment {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  accountId      String      @db.Uuid
  personEditorId String      @db.Uuid
  previousBalance Decimal    @db.Decimal(19, 2)
  targetBalance  Decimal     @db.Decimal(19, 2)
  difference     Decimal     @db.Decimal(19, 2)
  effectiveAt    DateTime    @db.Date
  notes          String?     @db.Text
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, accountId, effectiveAt])
  @@index([workspaceId, personEditorId])
}

model Transfer {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  sourceAccountId String     @db.Uuid
  destinationAccountId String @db.Uuid
  sourcePersonEditorId String @db.Uuid
  destinationPersonEditorId String @db.Uuid
  amount         Decimal     @db.Decimal(19, 2)
  transferDate   DateTime    @db.Date
  status         TransactionStatus @default(SETTLED)
  notes          String?     @db.Text
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAccount  FinancialAccount @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount FinancialAccount @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  sourcePersonEditor Editor @relation("TransferSourcePerson", fields: [sourcePersonEditorId], references: [id], onDelete: Restrict)
  destinationPersonEditor Editor @relation("TransferDestinationPerson", fields: [destinationPersonEditorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, transferDate])
  @@index([workspaceId, sourcePersonEditorId])
  @@index([workspaceId, destinationPersonEditorId])
}

model FixedExpense {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  categoryId     String?     @db.Uuid
  description    String      @db.VarChar(160)
  amount         Decimal     @db.Decimal(19, 2)
  dueDay         Int
  status         TransactionStatus @default(PENDING)
  active         Boolean     @default(true)
  startMonth     DateTime    @db.Date
  endedAt        DateTime?   @db.Date
  notes          String?     @db.Text
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@index([workspaceId, personEditorId, active])
  @@index([workspaceId, dueDay])
}

model Salary {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  categoryId     String?     @db.Uuid
  description    String      @db.VarChar(160)
  amount         Decimal     @db.Decimal(19, 2)
  frequency      SalaryFrequency @default(MONTHLY)
  paymentDay     Int
  startMonth     DateTime    @db.Date
  active         Boolean     @default(true)
  archivedAt     DateTime?   @db.Date
  notes          String?     @db.Text
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@index([workspaceId, personEditorId, active])
}

model Debt {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  categoryId     String?     @db.Uuid
  description    String      @db.VarChar(160)
  totalAmount    Decimal     @db.Decimal(19, 2)
  startDate      DateTime    @db.Date
  firstDueDate   DateTime    @db.Date
  installmentCount Int
  frequency      DebtInstallmentFrequency @default(MONTHLY)
  notes          String?     @db.Text
  active         Boolean     @default(true)
  canceledAt     DateTime?   @db.Date
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installments   DebtInstallment[]

  @@index([workspaceId, personEditorId, active])
}

model DebtInstallment {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  debtId         String      @db.Uuid
  personEditorId String      @db.Uuid
  number         Int
  amount         Decimal     @db.Decimal(19, 2)
  dueDate        DateTime    @db.Date
  paidAt         DateTime?   @db.Date
  status         DebtInstallmentStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  debt           Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  transaction    Transaction?

  @@unique([debtId, number])
  @@index([workspaceId, personEditorId, dueDate])
}

model CreditCard {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  paymentAccountId String?   @db.Uuid
  name           String      @db.VarChar(100)
  institution    String?     @db.VarChar(100)
  limit          Decimal     @db.Decimal(19, 2)
  closingDay     Int
  dueDay         Int
  color          String?     @db.VarChar(7)
  active         Boolean     @default(true)
  version        Int         @default(1)
  createdByEditorId String?  @db.Uuid
  updatedByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  paymentAccount FinancialAccount? @relation("CreditCardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  purchases      CreditCardPurchase[]
  installments   CreditCardInstallment[]
  invoices       CreditCardInvoice[]

  @@unique([workspaceId, personEditorId, name])
  @@index([workspaceId, personEditorId, active])
}

model CreditCardPurchase {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  cardId         String      @db.Uuid
  personEditorId String      @db.Uuid
  categoryId     String?     @db.Uuid
  description    String      @db.VarChar(160)
  totalAmount    Decimal     @db.Decimal(19, 2)
  installmentCount Int
  purchaseDate   DateTime    @db.Date
  notes          String?     @db.Text
  canceledAt     DateTime?   @db.Date
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card           CreditCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installments   CreditCardInstallment[]

  @@index([workspaceId, personEditorId, purchaseDate])
  @@index([workspaceId, cardId])
}

model CreditCardInstallment {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  cardId         String      @db.Uuid
  purchaseId     String      @db.Uuid
  invoiceId      String?     @db.Uuid
  personEditorId String      @db.Uuid
  categoryId     String?     @db.Uuid
  number         Int
  amount         Decimal     @db.Decimal(19, 2)
  dueMonth       DateTime    @db.Date
  status         CreditCardPurchaseInstallmentStatus @default(OPEN)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card           CreditCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  purchase       CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  invoice        CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transaction    Transaction?

  @@unique([purchaseId, number])
  @@index([workspaceId, personEditorId, dueMonth])
  @@index([workspaceId, cardId])
}

model CreditCardInvoice {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  cardId         String      @db.Uuid
  personEditorId String      @db.Uuid
  month          DateTime    @db.Date
  amount         Decimal     @default(0) @db.Decimal(19, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(19, 2)
  dueDate        DateTime    @db.Date
  status         CreditCardInvoiceStatus @default(OPEN)
  closedAt       DateTime?   @db.Date
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card           CreditCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  installments   CreditCardInstallment[]
  payments       CreditCardInvoicePayment[]

  @@unique([cardId, month])
  @@index([workspaceId, personEditorId, month])
}

model CreditCardInvoicePayment {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  invoiceId      String      @db.Uuid
  accountId      String      @db.Uuid
  personEditorId String      @db.Uuid
  amount         Decimal     @db.Decimal(19, 2)
  paidAt         DateTime    @db.Date
  notes          String?     @db.Text
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice        CreditCardInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, personEditorId, paidAt])
  @@index([workspaceId, accountId])
}

model SavingsGoal {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  name           String      @db.VarChar(120)
  targetAmount   Decimal     @db.Decimal(19, 2)
  deadline       DateTime?   @db.Date
  description    String?     @db.Text
  status         SavingsGoalStatus @default(ACTIVE)
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  movements      SavingsGoalMovement[]

  @@unique([workspaceId, personEditorId, name])
  @@index([workspaceId, personEditorId, status])
}

model SavingsGoalMovement {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  goalId         String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  type           SavingsGoalMovementType
  amount         Decimal     @db.Decimal(19, 2)
  movementDate   DateTime    @db.Date
  notes          String?     @db.Text
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal           SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, personEditorId, movementDate])
}

model Investment {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  personEditorId String      @db.Uuid
  accountId      String?     @db.Uuid
  name           String      @db.VarChar(120)
  institution    String?     @db.VarChar(120)
  amount         Decimal     @db.Decimal(19, 2)
  referenceDate  DateTime    @db.Date
  notes          String?     @db.Text
  active         Boolean     @default(true)
  createdByEditorId String?  @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personEditor   Editor      @relation(fields: [personEditorId], references: [id], onDelete: Restrict)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, personEditorId, active])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  editorId    String    @db.Uuid
  entityType  String    @db.VarChar(80)
  entityId    String?   @db.Uuid
  action      String    @db.VarChar(80)
  metadata    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editor      Editor    @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}
