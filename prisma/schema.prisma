generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL
  INVESTMENT
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  SETTLED
  CANCELED
}

enum DebtPaymentMethod {
  CREDIT_CARD
  OTHER
}

enum DebtInstallmentFrequency {
  MONTHLY
  FORTNIGHTLY
}

enum DebtInstallmentStatus {
  PENDING
  PAID
  CANCELED
}

enum SalaryFrequency {
  MONTHLY
  FORTNIGHTLY
}

enum FinancialContextType {
  PERSONAL
  COUPLE
}

enum FinancialContextMemberRole {
  MEMBER
}

enum CreditCardInvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
  CANCELED
}

enum CreditCardPurchaseInstallmentStatus {
  OPEN
  CANCELED
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SavingsGoalMovementType {
  DEPOSIT
  WITHDRAWAL
}

model Workspace {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique @db.VarChar(80)
  name         String             @db.VarChar(120)
  currency     String             @default("BRL") @db.Char(3)
  timezone     String             @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  editors      Editor[]
  financialContexts FinancialContext[]
  financialContextMembers FinancialContextMember[]
  accounts     FinancialAccount[]
  categories   Category[]
  transactions Transaction[]
  transfers    Transfer[]
  budgets      Budget[]
  debts        Debt[]
  fixedExpenses FixedExpense[]
  salaries     Salary[]
  balanceAdjustments AccountBalanceAdjustment[]
  auditLogs    AuditLog[]
  creditCards  CreditCard[]
  creditCardInvoices CreditCardInvoice[]
  creditCardPurchases CreditCardPurchase[]
  creditCardPurchaseInstallments CreditCardPurchaseInstallment[]
  savingsGoals SavingsGoal[]
  savingsGoalMovements SavingsGoalMovement[]
}

model Editor {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  displayName String        @db.VarChar(80)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants      AccessGrant[]
  auditLogs   AuditLog[]
  debtShares  DebtInstallmentShare[]
  fixedExpenses FixedExpense[]
  salaries    Salary[]
  ownedAccounts FinancialAccount[] @relation("AccountOwner")
  balanceAdjustments AccountBalanceAdjustment[]
  financialContexts FinancialContext[] @relation("PersonalFinancialContextOwner")
  financialContextMemberships FinancialContextMember[]
  savingsGoalMovements SavingsGoalMovement[]

  @@unique([workspaceId, displayName])
  @@index([workspaceId, active])
}

model FinancialContext {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  ownerEditorId String?            @db.Uuid
  type        FinancialContextType
  name        String               @db.VarChar(80)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerEditor Editor?              @relation("PersonalFinancialContextOwner", fields: [ownerEditorId], references: [id], onDelete: Cascade)
  accounts    FinancialAccount[]
  categories  Category[]
  transactions Transaction[]
  sourceTransfers Transfer[]       @relation("TransferSourceContext")
  destinationTransfers Transfer[]  @relation("TransferDestinationContext")
  balanceAdjustments AccountBalanceAdjustment[]
  budgets     Budget[]
  fixedExpenses FixedExpense[]
  salaries    Salary[]
  debts       Debt[]
  auditLogs   AuditLog[]
  creditCards CreditCard[]
  creditCardInvoices CreditCardInvoice[]
  creditCardPurchases CreditCardPurchase[]
  creditCardPurchaseInstallments CreditCardPurchaseInstallment[]
  savingsGoals SavingsGoal[]
  members     FinancialContextMember[]
  savingsGoalMovements SavingsGoalMovement[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active, type])
  @@index([workspaceId, ownerEditorId])
}

model FinancialContextMember {
  id                 String                     @id @default(uuid()) @db.Uuid
  workspaceId        String                     @db.Uuid
  financialContextId String                     @db.Uuid
  editorId           String                     @db.Uuid
  role               FinancialContextMemberRole @default(MEMBER)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext   FinancialContext           @relation(fields: [financialContextId], references: [id], onDelete: Cascade)
  editor             Editor                     @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@unique([financialContextId, editorId])
  @@index([workspaceId, editorId])
  @@index([workspaceId, financialContextId])
}

model AccessGrant {
  id         String          @id @default(uuid()) @db.Uuid
  editorId   String          @db.Uuid
  tokenHash  String          @unique @db.Char(64)
  active     Boolean         @default(true)
  lastUsedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  editor     Editor          @relation(fields: [editorId], references: [id], onDelete: Cascade)
  sessions   AccessSession[]

  @@index([editorId, active])
}

model AccessSession {
  id        String      @id @default(uuid()) @db.Uuid
  grantId   String      @db.Uuid
  tokenHash String      @unique @db.Char(64)
  expiresAt DateTime    @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  grant     AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

model FinancialAccount {
  id             String      @id @default(uuid()) @db.Uuid
  workspaceId    String      @db.Uuid
  contextId      String      @db.Uuid
  ownerEditorId  String?     @db.Uuid
  name           String      @db.VarChar(100)
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(19, 2)
  color          String?     @db.VarChar(7)
  active         Boolean     @default(true)
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  ownerEditor    Editor?     @relation("AccountOwner", fields: [ownerEditorId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  fixedExpenses  FixedExpense[]
  salaries       Salary[]
  outgoing       Transfer[]  @relation("TransferSource")
  incoming       Transfer[]  @relation("TransferDestination")
  balanceAdjustments AccountBalanceAdjustment[]
  creditCardPayments CreditCard[] @relation("CreditCardPaymentAccount")
  savingsGoals SavingsGoal[] @relation("SavingsGoalAccount")
  savingsGoalMovements SavingsGoalMovement[] @relation("SavingsGoalMovementAccount")

  @@unique([contextId, name])
  @@index([workspaceId, active])
  @@index([workspaceId, contextId, active])
  @@index([workspaceId, ownerEditorId])
  @@index([workspaceId, type])
}

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @db.Uuid
  contextId    String       @db.Uuid
  parentId     String?      @db.Uuid
  name         String       @db.VarChar(100)
  kind         CategoryKind
  color        String?      @db.VarChar(7)
  active       Boolean      @default(true)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  debts        Debt[]
  fixedExpenses FixedExpense[]
  salaries     Salary[]
  creditCardPurchases CreditCardPurchase[]

  @@unique([contextId, kind, name])
  @@index([workspaceId, kind, active])
  @@index([workspaceId, contextId, kind, active])
  @@index([parentId])
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @db.Uuid
  contextId      String            @db.Uuid
  accountId      String            @db.Uuid
  categoryId     String?           @db.Uuid
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  description    String            @db.VarChar(160)
  amount         Decimal           @db.Decimal(19, 2)
  competenceDate DateTime          @db.Date
  dueDate        DateTime?         @db.Date
  settledAt      DateTime?         @db.Timestamptz(3)
  notes          String?           @db.VarChar(1000)
  affectsBalance Boolean           @default(true)
  fixedExpenseId String?            @db.Uuid
  recurrenceMonth DateTime?         @db.Date
  salaryId       String?            @db.Uuid
  salaryMonth    DateTime?          @db.Date
  salaryInstallment Int?
  creditCardInvoiceId String?        @db.Uuid
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  account        FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  debtInstallment DebtInstallment?
  fixedExpense   FixedExpense?     @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  salary         Salary?           @relation(fields: [salaryId], references: [id], onDelete: SetNull)
  creditCardInvoice CreditCardInvoice? @relation(fields: [creditCardInvoiceId], references: [id], onDelete: SetNull)

  @@unique([fixedExpenseId, recurrenceMonth])
  @@unique([salaryId, salaryMonth, salaryInstallment])
  @@index([workspaceId, contextId, competenceDate])
  @@index([workspaceId, competenceDate])
  @@index([workspaceId, status, dueDate])
  @@index([accountId, competenceDate])
  @@index([categoryId])
  @@index([creditCardInvoiceId])
}

model Transfer {
  id                   String            @id @default(uuid()) @db.Uuid
  workspaceId          String            @db.Uuid
  sourceContextId      String            @db.Uuid
  destinationContextId String            @db.Uuid
  sourceAccountId      String            @db.Uuid
  destinationAccountId String            @db.Uuid
  status               TransactionStatus @default(SETTLED)
  description          String            @db.VarChar(160)
  amount               Decimal           @db.Decimal(19, 2)
  transferDate         DateTime          @db.Date
  settledAt            DateTime?         @db.Timestamptz(3)
  notes                String?           @db.VarChar(1000)
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceContext        FinancialContext  @relation("TransferSourceContext", fields: [sourceContextId], references: [id], onDelete: Restrict)
  destinationContext   FinancialContext  @relation("TransferDestinationContext", fields: [destinationContextId], references: [id], onDelete: Restrict)
  sourceAccount        FinancialAccount  @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   FinancialAccount  @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  @@index([workspaceId, transferDate])
  @@index([workspaceId, sourceContextId, transferDate])
  @@index([workspaceId, destinationContextId, transferDate])
  @@index([sourceAccountId, transferDate])
  @@index([destinationAccountId, transferDate])
}

model AccountBalanceAdjustment {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  contextId       String           @db.Uuid
  accountId       String           @db.Uuid
  editorId        String           @db.Uuid
  previousBalance Decimal          @db.Decimal(19, 2)
  informedBalance Decimal          @db.Decimal(19, 2)
  difference      Decimal          @db.Decimal(19, 2)
  effectiveAt     DateTime         @default(now()) @db.Timestamptz(3)
  notes           String?          @db.VarChar(1000)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  editor          Editor           @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, effectiveAt])
  @@index([workspaceId, contextId, effectiveAt])
  @@index([accountId, effectiveAt])
  @@index([editorId])
}

model Budget {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  contextId   String    @db.Uuid
  categoryId  String    @db.Uuid
  month       DateTime  @db.Date
  amount      Decimal   @db.Decimal(19, 2)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([contextId, categoryId, month])
  @@index([workspaceId, month])
  @@index([workspaceId, contextId, month])
  @@index([categoryId])
}

model FixedExpense {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  contextId   String    @db.Uuid
  accountId   String    @db.Uuid
  categoryId  String    @db.Uuid
  editorId    String    @db.Uuid
  description String    @db.VarChar(160)
  amount      Decimal   @db.Decimal(19, 2)
  dueDay      Int
  startMonth  DateTime  @db.Date
  notes       String?   @db.VarChar(1000)
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  editor      Editor    @relation(fields: [editorId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([workspaceId, active, startMonth])
  @@index([workspaceId, contextId, active, startMonth])
  @@index([accountId])
  @@index([categoryId])
  @@index([editorId])
}

model Salary {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  contextId   String          @db.Uuid
  accountId   String          @db.Uuid
  categoryId  String          @db.Uuid
  editorId    String          @db.Uuid
  description String          @db.VarChar(160)
  amount      Decimal         @db.Decimal(19, 2)
  frequency   SalaryFrequency
  paymentDay  Int?
  startMonth  DateTime        @db.Date
  notes       String?         @db.VarChar(1000)
  active      Boolean         @default(true)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  editor      Editor          @relation(fields: [editorId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([workspaceId, active, startMonth])
  @@index([workspaceId, contextId, active, startMonth])
  @@index([accountId])
  @@index([categoryId])
  @@index([editorId])
}

model Debt {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  contextId        String            @db.Uuid
  categoryId       String            @db.Uuid
  description      String            @db.VarChar(160)
  paymentMethod    DebtPaymentMethod
  cardName         String?           @db.VarChar(100)
  totalAmount      Decimal           @db.Decimal(19, 2)
  purchaseDate     DateTime          @db.Date
  firstDueDate     DateTime          @db.Date
  installmentFrequency DebtInstallmentFrequency @default(MONTHLY)
  installmentCount Int
  notes            String?           @db.VarChar(1000)
  canceledAt       DateTime?         @db.Timestamptz(3)
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext  @relation(fields: [contextId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments     DebtInstallment[]

  @@index([workspaceId, purchaseDate])
  @@index([workspaceId, contextId, purchaseDate])
  @@index([workspaceId, canceledAt])
  @@index([categoryId])
}

model DebtInstallment {
  id            String                  @id @default(uuid()) @db.Uuid
  debtId        String                  @db.Uuid
  transactionId String?                 @unique @db.Uuid
  number        Int
  amount        Decimal                 @db.Decimal(19, 2)
  dueDate       DateTime                @db.Date
  status        DebtInstallmentStatus   @default(PENDING)
  historical    Boolean                 @default(false)
  paidAt        DateTime?               @db.Timestamptz(3)
  version       Int                     @default(1)
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(3)
  debt          Debt                    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction   Transaction?            @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  shares        DebtInstallmentShare[]

  @@unique([debtId, number])
  @@index([debtId, status])
  @@index([status, dueDate])
}

model DebtInstallmentShare {
  installmentId String          @db.Uuid
  editorId      String          @db.Uuid
  amount        Decimal         @db.Decimal(19, 2)
  installment   DebtInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  editor        Editor          @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@id([installmentId, editorId])
  @@index([editorId])
}

model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  contextId     String?   @db.Uuid
  actorEditorId String?   @db.Uuid
  action        String    @db.VarChar(80)
  entityType    String    @db.VarChar(80)
  entityId      String?   @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  actor         Editor?   @relation(fields: [actorEditorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, contextId, createdAt])
  @@index([entityType, entityId])
}

model CreditCard {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  contextId        String    @db.Uuid
  paymentAccountId String?   @db.Uuid
  name             String    @db.VarChar(100)
  institution      String?   @db.VarChar(100)
  limit            Decimal   @db.Decimal(19, 2)
  closingDay       Int
  dueDay           Int
  color            String?   @db.VarChar(7)
  active           Boolean   @default(true)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  paymentAccount   FinancialAccount? @relation("CreditCardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  invoices         CreditCardInvoice[]
  purchases        CreditCardPurchase[]

  @@unique([contextId, name])
  @@index([workspaceId, contextId, active])
  @@index([paymentAccountId])
}

model CreditCardInvoice {
  id               String                  @id @default(uuid()) @db.Uuid
  workspaceId      String                  @db.Uuid
  contextId        String                  @db.Uuid
  creditCardId     String                  @db.Uuid
  month            DateTime                @db.Date
  status           CreditCardInvoiceStatus @default(OPEN)
  closesAt         DateTime                @db.Date
  dueDate          DateTime                @db.Date
  amount           Decimal                 @default(0) @db.Decimal(19, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(19, 2)
  paidAt           DateTime?               @db.Timestamptz(3)
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext        @relation(fields: [contextId], references: [id], onDelete: Restrict)
  creditCard       CreditCard              @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  installments     CreditCardPurchaseInstallment[]
  paymentTransactions Transaction[]

  @@unique([creditCardId, month])
  @@index([workspaceId, contextId, month])
  @@index([creditCardId, status])
}

model CreditCardPurchase {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  contextId         String    @db.Uuid
  creditCardId      String    @db.Uuid
  categoryId        String?   @db.Uuid
  description       String    @db.VarChar(160)
  totalAmount       Decimal   @db.Decimal(19, 2)
  installmentCount  Int       @default(1)
  purchaseDate      DateTime  @db.Date
  firstInvoiceMonth DateTime  @db.Date
  notes             String?   @db.VarChar(1000)
  canceledAt        DateTime? @db.Timestamptz(3)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext  FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  creditCard        CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installments      CreditCardPurchaseInstallment[]

  @@index([workspaceId, contextId, purchaseDate])
  @@index([creditCardId, purchaseDate])
  @@index([categoryId])
}

model CreditCardPurchaseInstallment {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  contextId        String    @db.Uuid
  purchaseId       String    @db.Uuid
  invoiceId        String    @db.Uuid
  number           Int
  amount           Decimal   @db.Decimal(19, 2)
  dueMonth         DateTime  @db.Date
  status           CreditCardPurchaseInstallmentStatus @default(OPEN)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  purchase         CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  invoice          CreditCardInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@index([workspaceId, contextId, dueMonth])
  @@index([invoiceId])
}

model SavingsGoal {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  contextId        String    @db.Uuid
  accountId        String?   @db.Uuid
  name             String    @db.VarChar(100)
  targetAmount     Decimal   @db.Decimal(19, 2)
  deadline         DateTime? @db.Date
  description      String?   @db.VarChar(1000)
  status           SavingsGoalStatus @default(ACTIVE)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  account          FinancialAccount? @relation("SavingsGoalAccount", fields: [accountId], references: [id], onDelete: SetNull)
  movements        SavingsGoalMovement[]

  @@unique([contextId, name])
  @@index([workspaceId, contextId, status])
  @@index([accountId])
}

model SavingsGoalMovement {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  contextId        String    @db.Uuid
  savingsGoalId    String    @db.Uuid
  accountId        String?   @db.Uuid
  editorId         String    @db.Uuid
  type             SavingsGoalMovementType
  amount           Decimal   @db.Decimal(19, 2)
  movementDate     DateTime  @db.Date
  notes            String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Restrict)
  savingsGoal      SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  account          FinancialAccount? @relation("SavingsGoalMovementAccount", fields: [accountId], references: [id], onDelete: SetNull)
  editor           Editor @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, contextId, movementDate])
  @@index([savingsGoalId, movementDate])
  @@index([accountId])
}
